{
    "name": "versacompiler",
    "version": "2.6.7",
    "description": "Una herramienta para compilar y minificar archivos .vue, .js y .ts para proyectos de Vue 3 con soporte para TypeScript.",
    "keywords": [
        "compiler",
        "linter",
        "minifier",
        "typescript",
        "versacompiler",
        "vue",
        "vue3"
    ],
    "homepage": "https://github.com/kriollo/versaCompiler#readme",
    "bugs": {
        "url": "https://github.com/kriollo/versaCompiler/issues"
    },
    "license": "MIT",
    "author": "Jorge Jara H (kriollone@gmail.com)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kriollo/versaCompiler.git"
    },
    "bin": {
        "versacompiler": "dist/main.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "type": "module",
    "main": "dist/main.js",
    "types": "dist/config.d.ts",
    "exports": {
        ".": {
            "import": "./dist/main.js",
            "types": "./dist/main.d.ts"
        },
        "./config": {
            "import": "./dist/config.js",
            "types": "./dist/config.d.ts"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "tsx --watch src/main.ts --watch --verbose --tailwind",
        "file": "tsx src/main.ts ",
        "build": "tsx src/main.ts --all --cc --co -y && pnpm build:types",
        "build:types": "tsc -p tsconfig.declarations.json",
        "prepublishOnly": "pnpm build",
        "compileDev": "tsx src/main.ts --all --ci --cc -y -t --linter --verbose",
        "vlint": "tsx src/main.ts --all --cc --co -y --linter",
        "vtlint": "tsx src/main.ts --all --cc --co -y -t --verbose",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "e2e:report": "playwright show-report playwright-report",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "lint": "oxlint --fix --config .oxlintrc.json",
        "lint:eslint": "eslint --ext .js,.ts,.vue src/ --fix",
        "fmt": "oxfmt --write --config .oxfmtrc.json ."
    },
    "dependencies": {
        "@vue/compiler-dom": "^3.5.42",
        "@vue/reactivity": "^3.5.42",
        "@vue/runtime-core": "^3.5.42",
        "@vue/runtime-dom": "^3.5.42",
        "browser-sync": "^3.0.4",
        "chalk": "6.0.0",
        "chokidar": "^5.0.0",
        "enhanced-resolve": "^5.24.5",
        "execa": "^10.0.1",
        "find-root": "^1.1.0",
        "fs-extra": "^11.4.0",
        "get-port": "^7.2.0",
        "minify-html-literals": "^1.3.5",
        "minimatch": "^10.2.6",
        "oxc-minify": "^0.149.0",
        "oxc-parser": "^0.149.0",
        "oxc-transform": "^0.149.0",
        "resolve": "^1.22.12",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "vue": "3.5.42",
        "yargs": "^18.1.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/cli": "^4.3.3",
        "@types/browser-sync": "^2.29.1",
        "@types/find-root": "^1.1.4",
        "@types/fs-extra": "^11.0.4",
        "@types/jest": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.20.2",
        "@types/resolve": "^1.20.6",
        "@types/yargs": "^17.0.35",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/ui": "^5.0.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.0",
        "@vueuse/core": "^14.4.0",
        "code-tag": "^1.2.0",
        "eslint": "^10.10.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-oxlint": "^1.82.0",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-unicorn": "^74.0.0",
        "eslint-plugin-vue": "^10.11.0",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "pinia": "^4.0.3",
        "prettier": "3.9.6",
        "rimraf": "^6.1.3",
        "sweetalert2": "^11.26.25",
        "tailwindcss": "^4.3.3",
        "vitest": "^5.0.0",
        "vue-eslint-parser": "^10.4.1",
        "vue-router": "^5.3.1",
        "zod": "^4.6.2"
    },
    "packageManager": "pnpm@12.3.4"
}
